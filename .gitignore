# =============================================================================
# Token Plan Dashboard — .gitignore
#
# 原则：仓库只收录「插件源码 + 项目文档 + 验证证据」。
# 凡属本机环境、可再生产物、第三方调研克隆、以及任何可能含凭证的文件，一律不入库。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 依赖与包管理器
# -----------------------------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-debug.log*
.yarn/
.yarnrc.yml
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# 2. 构建产物与缓存（本插件为源码直发 bundle，无构建步骤；下列为通用防护）
# -----------------------------------------------------------------------------
dist/
build/
out/
output/
lib/
coverage/
*.tsbuildinfo
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.vite/
.turbo/
.nx/
*.bundle.js
*.min.js.map

# -----------------------------------------------------------------------------
# 3. 第三方调研克隆（临时材料，非本项目内容）
#    .recon/ 内是临时 clone 下来的他人仓库，自带 .git，入库会变成
#    embedded repository（gitlink）从而破坏仓库；调研结论已沉淀到
#    docs/reference/ 与 CONSTRAINTS.md，克隆本体不保留。
# -----------------------------------------------------------------------------
.recon/
/recon/
/reference/
/vendor-src/
/tmp/
/scratch/

# -----------------------------------------------------------------------------
# 4. 凭证与本地配置（硬约束：任何凭证都不得进 git，见 AGENTS.md）
#    插件凭证走 ctx.credentials 服务；下列条目防御本机残留的明文文件。
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
.credentials
.credentials.*
credentials.json
secrets.json
config.local.json
*.local.json
*.secret.json

# -----------------------------------------------------------------------------
# 5. 日志与临时文件
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
*.rej
*~
*.swp
*.swo
*.pid
*.seed

# -----------------------------------------------------------------------------
# 6. 编辑器与 IDE
# -----------------------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
*.ipr
*.iws
.fleet/
*.code-workspace
.history/

# -----------------------------------------------------------------------------
# 7. 操作系统
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# 8. 打包产物（安装走 dsh plugin add / Web 插件页，不依赖仓库内 tarball）
# -----------------------------------------------------------------------------
*.tgz
*.tar.gz
*.zip
*.7z
*.rar

# -----------------------------------------------------------------------------
# 9. 本机实机验证残留（截图、抓包、脱敏样本等，按需另存到 verification/）
# -----------------------------------------------------------------------------
/tmp-verify/
/playwright-report/
/test-results/
/verification/scratch/
